const { Builder, By, until } = require("selenium-webdriver");
const assert = require("assert");

async function viewProductListTest() {
  let driver = await new Builder().forBrowser("chrome").build();
  try {
    await driver.get("http://localhost/ospos/public/login");
    await driver.findElement(By.id("input-username")).sendKeys("admin");
    await driver.findElement(By.id("input-password")).sendKeys("pointofsale");
    await driver.findElement(By.id("submit-button")).click();

    await driver.wait(
      async () => {
        let url = await driver.getCurrentUrl();
        return !url.includes("/login") && url.includes("/home");
      },
      10000,
      "Did not reach the home page",
    );

    let heading = await driver.wait(
      until.elementLocated(
        By.xpath(
          "//h3[contains(@class, 'text-center') and contains(., 'Welcome to OSPOS')]",
        ),
      ),
      10000,
    );
    await driver.wait(until.elementIsVisible(heading), 10000);

    let itemsLinkLocator = By.css(
      "a[href='http://localhost/ospos/public/items'], a[href$='/items']",
    );
    let itemsLink = await driver.wait(
      until.elementLocated(itemsLinkLocator),
      10000,
    );
    await driver.wait(until.elementIsVisible(itemsLink), 10000);
    await itemsLink.click();

    // Confirm navigation to /items
    await driver.wait(until.urlContains("/items"), 10000);

    let listContainer = await driver.wait(
      async () => {
        let handles = await driver.getAllWindowHandles();
        if (handles.length === 0) {
          throw new Error(
            "Browser window was closed before items list loaded.",
          );
        }

        let candidates = await driver.findElements(
          By.css("table, #table, .bootstrap-table, main, #content"),
        );
        for (let el of candidates) {
          if (await el.isDisplayed()) {
            return el;
          }
        }
        return false;
      },
      10000,
      "Items page content did not become visible",
    );

    assert.ok(listContainer, "Items container not found");
    console.log(
      "Product list opened successfully! Current URL:",
      await driver.getCurrentUrl(),
    );
  } finally {
    try {
      let handles = await driver.getAllWindowHandles();
      if (handles.length > 0) {
        await driver.quit();
      }
    } catch (_) {
      // Ignore cleanup errors if already closed
    }
  }
}

viewProductListTest();
